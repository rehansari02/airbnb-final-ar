<% layout("/layouts/boilerplate") %>

  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-evenly;
      margin-bottom: 2rem;
    }

    .filter {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 0.5rem 1rem;
      opacity: 0.6;
      transition: opacity 0.3s;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }

    .filter p {
      font-size: 1.2vw;
      margin-top: 0.3rem;
    }

    .info-tax {
      border: 1px solid rgb(205, 195, 195);
      padding: 0.4vw 0.3vw;
      border-radius: 2vw;
      display: flex;
      align-items: center;
    }


    .card {
      transition: all 0.3s ease;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
      /* soft shadow initially */
      border-radius: 10px;
      overflow: hidden;
      background-color: #fff;
    }

    .card:hover {
      transform: translateY(-12px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);

    }

    .card-img-top {
      height: 200px;
      object-fit: cover;
    }

    .tax {
      display: none;
    }

    .card-img-overlay {
      opacity: 0;
      transition: opacity 0.3s;
    }

    .card-img-overlay:hover {
      opacity: 0.2;
      background-color: #f0f8ff;
    }

    a.text-dark {
      text-decoration: none;
      color: inherit;
    }
  </style>

  <!-- ================= Filters ================= -->
  <div id="filters">
    <% const filterItems=[ { icon: "fa-solid fa-fire" , label: "Trending" }, { icon: "ri-hotel-bed-fill" ,
      label: "Rooms" }, { icon: "ri-building-line" , label: "Iconis" }, { icon: "fa-solid fa-mountain-sun" ,
      label: "Mountains" }, { icon: "fa-solid fa-umbrella-beach" , label: "Beach" }, {
      icon: "fa-solid fa-person-swimming" , label: "Pool" }, { icon: "fa-solid fa-sun" , label: "Sunset" }, {
      icon: "ri-tent-line" , label: "Camping" }, { icon: "fa-solid fa-cow" , label: "Farms" }, {
      icon: "ri-snowflake-line" , label: "Arctic" }, { icon: "fa-solid fa-hill-avalanche" , label: "Hills" }, {
      icon: "fa-solid fa-tree" , label: "Forest" } ]; %>

      <% filterItems.forEach(item=> { %>
        <div class="filter">
          <div><i class="<%= item.icon %>"></i></div>
          <p>
            <%= item.label %>
          </p>
        </div>
        <% }); %>

          <div class="info-tax">
            <div class="form-check-reverse form-switch mx-4">
              <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
              <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
          </div>
  </div>

  <!-- ================= Listings ================= -->
  <div class="container mt-4 mb-3">
    <div class="row g-4">
      <% for (let datas of data) { %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <a href="/listings/<%= datas.id %>" class="text-decoration-none text-dark">
            <div class="card h-100">
              <img src="<%= datas.image.url %>" class="card-img-top" alt="listings">
              <div class="card-body">
                <p class="card-text mb-1"><b>
                    <%= datas.title %>
                  </b></p>
                <p class="card-text">
                  <%= datas.price %>&#8377; /Night
                    <i class="tax">&nbsp;+18% GST</i>
                </p>
              </div>
            </div>
          </a>
        </div>
        <% } %>
    </div>
  </div>

  <!-- ================= Script ================= -->
  <script>
    const taxSwitch = document.querySelector("#switchCheckDefault");
    const taxElements = document.querySelectorAll(".tax");

    taxSwitch.addEventListener("change", () => {
      taxElements.forEach(el => {
        el.style.display = taxSwitch.checked ? "inline" : "none";
      });
    });
  </script>